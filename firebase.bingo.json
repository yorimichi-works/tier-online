{
  "hosting": {
    "site": "bingo-online",
    "public": "build/bingo_web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "function": "bingoSitemap"
      },
      {
        "source": "/{ja,ko,zh-tw,pt-br,en}/**",
        "function": "renderBingo"
      },
      {
        "source": "/{ja,ko,zh-tw,pt-br,en}",
        "function": "renderBingo"
      },
      {
        "source": "/",
        "function": "renderBingo"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
