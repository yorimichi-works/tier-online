rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/topics/{topicId}/items/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Bingo Online cell images: 400px JPEG recompressed on the client to
    // <=80KB (BingoImagePolicy). The 200KB cap rejects uncompressed uploads.
    // Like Tier, uploading needs a registered account; publishBingo only
    // accepts URLs from the uploader's own folder.
    match /users/{userId}/bingos/{bingoId}/cells/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        fileName.matches('[0-9]{1,2}[.]jpg') &&
        request.resource.size < 200 * 1024 &&
        request.resource.contentType == 'image/jpeg';
    }
  }
}
