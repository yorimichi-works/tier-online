rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // メール/パスワード登録ユーザーのみメール確認を必須にする。匿名・Google
    // (Google側で確認済み)ユーザーはこのチェックの対象外。
    function emailVerifiedOrExempt() {
      return request.auth.token.firebase.sign_in_provider != 'password' ||
        request.auth.token.email_verified == true;
    }

    function ownsTopic(topicId) {
      return signedIn() &&
        get(/databases/$(database)/documents/topics/$(topicId)).data.creatorId == request.auth.uid;
    }

    function canViewTopic(topicId) {
      let topic = get(/databases/$(database)/documents/topics/$(topicId)).data;
      return topic.get('isPublic', true) == true ||
        (signedIn() && topic.creatorId == request.auth.uid);
    }

    function translationFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'translations',
        'translationStatus',
        'contentVersion',
        'sourceContentHash',
        'translationBatchId',
        'processingStartedAt',
        'lastTranslationBatchId',
        'translationUpdatedAt',
        'hasTranslationReviewRequired'
      ]);
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /dailyTierCounters/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /adBonusTokens/{tokenId} {
      allow read, write: if false;
    }

    match /moderationConfig/{configId} {
      allow read: if false;
      allow write: if false;
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // 問い合わせ/削除依頼はsubmitContactRequest(Admin SDK)経由のみで作成する。
    match /contactRequests/{id} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /tierRegionStats/{statsId} {
      allow read: if true;
      allow write: if false;
    }

    // ----- Bingo Online (lib/bingo) -----
    function bingoDoc(bingoId) {
      return get(/databases/$(database)/documents/bingos/$(bingoId)).data;
    }

    function canViewBingo(bingoId) {
      let bingo = bingoDoc(bingoId);
      return bingo.get('listed', false) == true ||
        (signedIn() && bingo.creatorId == request.auth.uid);
    }

    function ownsBingo(bingoId) {
      return signedIn() && bingoDoc(bingoId).creatorId == request.auth.uid;
    }

    // Collection-group read for "My Bingo" (the participant's own cards).
    match /{path=**}/bingoEntries/{entryId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Collection-group read of the caller's own reactions on one board.
    match /{path=**}/reactions/{reactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /bingos/{bingoId} {
      allow read: if resource.data.get('listed', false) == true ||
        (signedIn() && resource.data.creatorId == request.auth.uid);
      // Publishing goes through publishBingo (moderation + rate limits) and
      // deletion through deleteBingo (recursive), never from the client.
      allow create, delete: if false;
      // The owner may only switch visibility. `listed` must stay consistent
      // with the server-owned moderation status.
      allow update: if signedIn() &&
        resource.data.creatorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isPublic', 'listed', 'updatedAt']) &&
        request.resource.data.isPublic is bool &&
        request.resource.data.listed ==
          (request.resource.data.isPublic &&
           resource.data.get('moderationStatus', 'approved') != 'blocked');

      match /bingoEntries/{userId} {
        allow read: if canViewBingo(bingoId);
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          canViewBingo(bingoId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(
            ['userId', 'userName', 'layout', 'marked', 'firstBingoAt', 'updatedAt']) &&
          request.resource.data.userName is string &&
          request.resource.data.userName.size() <= 24 &&
          request.resource.data.layout is list &&
          request.resource.data.layout.size() == bingoDoc(bingoId).size * bingoDoc(bingoId).size &&
          request.resource.data.marked is list &&
          request.resource.data.marked.size() <= 25;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      // Likes are counted into bingos/{id}.likeCount by aggregateBingoLikes.
      match /likes/{userId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() &&
          request.auth.uid == userId &&
          canViewBingo(bingoId) &&
          emailVerifiedOrExempt() &&
          request.resource.data.keys().hasOnly(['userId', 'bingoId', 'createdAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.bingoId == bingoId;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if canViewBingo(bingoId);
        // Created by postBingoComment so the attached result is server-made.
        allow create, update: if false;
        allow delete: if signedIn() &&
          (resource.data.authorId == request.auth.uid || ownsBingo(bingoId));

        // One reaction per person per comment; counted into
        // comments/{id}.reactionCounts by countBingoCommentReactions.
        match /reactions/{userId} {
          allow read: if signedIn() && request.auth.uid == userId;
          allow create, update: if signedIn() &&
            request.auth.uid == userId &&
            canViewBingo(bingoId) &&
            emailVerifiedOrExempt() &&
            exists(/databases/$(database)/documents/bingos/$(bingoId)/comments/$(commentId)) &&
            request.resource.data.keys().hasOnly(
              ['userId', 'bingoId', 'commentId', 'reaction', 'updatedAt']) &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.bingoId == bingoId &&
            request.resource.data.commentId == commentId &&
            request.resource.data.reaction in ['clap', 'party', 'laugh', 'heart'];
          allow delete: if signedIn() && request.auth.uid == userId;
        }
      }

      match /reports/{reportId} {
        allow create: if signedIn() &&
          canViewBingo(bingoId) &&
          emailVerifiedOrExempt() &&
          request.resource.data.reporterUserId == request.auth.uid &&
          request.resource.data.targetType in ['bingo', 'comment'] &&
          request.resource.data.targetId is string &&
          reportId == request.resource.data.targetType + '_' +
            request.resource.data.targetId + '_' + request.auth.uid;
        allow read, update, delete: if false;
      }
    }

    match /topics/{topicId} {
      allow read: if resource.data.get('isPublic', true) == true ||
        (signedIn() && resource.data.creatorId == request.auth.uid);
      // 作成/公開はモデレーション・レート制限を必ず通す publishTierTopic
      // Callable Function(Admin SDK)経由に限定し、クライアントからの直接
      // 作成は禁止する。
      allow create: if false;
      allow update: if signedIn() && resource.data.creatorId == request.auth.uid &&
        request.resource.data.creatorId == resource.data.creatorId &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.community == resource.data.community &&
        request.resource.data.distributions == resource.data.distributions &&
        request.resource.data.disagreement == resource.data.disagreement &&
        request.resource.data.get('likeCount', 0) ==
          resource.data.get('likeCount', 0) &&
        translationFieldsUnchanged();
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;

      match /items/{itemId} {
        allow read: if canViewTopic(topicId);
        allow write: if ownsTopic(topicId) ||
          (signedIn() &&
           getAfter(/databases/$(database)/documents/topics/$(topicId)).data.creatorId == request.auth.uid);
      }

      match /submissions/{userId} {
        allow read: if canViewTopic(topicId);
        allow write: if signedIn() && request.auth.uid == userId &&
          canViewTopic(topicId);
      }

      match /talks/{talkId} {
        allow read: if canViewTopic(topicId);
        allow create, update: if signedIn() && canViewTopic(topicId) &&
          emailVerifiedOrExempt();
        allow delete: if ownsTopic(topicId);
      }

      match /reports/{reportId} {
        allow create: if signedIn() &&
          canViewTopic(topicId) &&
          emailVerifiedOrExempt() &&
          request.resource.data.reporterUserId == request.auth.uid;
        allow read, update, delete: if false;
      }

      match /likes/{userId} {
        allow read: if signedIn() && request.auth.uid == userId &&
          canViewTopic(topicId);
        allow create: if signedIn() && request.auth.uid == userId &&
          canViewTopic(topicId) &&
          emailVerifiedOrExempt() &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
    }
  }
}
