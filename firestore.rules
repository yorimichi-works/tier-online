rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // メール/パスワード登録ユーザーのみメール確認を必須にする。匿名・Google
    // (Google側で確認済み)ユーザーはこのチェックの対象外。
    function emailVerifiedOrExempt() {
      return request.auth.token.firebase.sign_in_provider != 'password' ||
        request.auth.token.email_verified == true;
    }

    function ownsTopic(topicId) {
      return signedIn() &&
        get(/databases/$(database)/documents/topics/$(topicId)).data.creatorId == request.auth.uid;
    }

    function canViewTopic(topicId) {
      let topic = get(/databases/$(database)/documents/topics/$(topicId)).data;
      return topic.get('isPublic', true) == true ||
        (signedIn() && topic.creatorId == request.auth.uid);
    }

    function translationFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'translations',
        'translationStatus',
        'contentVersion',
        'sourceContentHash',
        'translationBatchId',
        'processingStartedAt',
        'lastTranslationBatchId',
        'translationUpdatedAt',
        'hasTranslationReviewRequired'
      ]);
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /dailyTierCounters/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /clientPolicies/{policyId} {
      allow read: if policyId == 'talks';
      allow write: if false;
    }

    match /adBonusTokens/{tokenId} {
      allow read, write: if false;
    }

    match /moderationConfig/{configId} {
      allow read: if false;
      allow write: if false;
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // 問い合わせ/削除依頼はsubmitContactRequest(Admin SDK)経由のみで作成する。
    match /contactRequests/{id} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /tierRegionStats/{statsId} {
      allow read: if true;
      allow write: if false;
    }

    match /topics/{topicId} {
      allow read: if resource.data.get('isPublic', true) == true ||
        (signedIn() && resource.data.creatorId == request.auth.uid);
      // 作成/公開はモデレーション・レート制限を必ず通す publishTierTopic
      // Callable Function(Admin SDK)経由に限定し、クライアントからの直接
      // 作成は禁止する。
      allow create: if false;
      allow update: if signedIn() && resource.data.creatorId == request.auth.uid &&
        request.resource.data.creatorId == resource.data.creatorId &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.community == resource.data.community &&
        request.resource.data.distributions == resource.data.distributions &&
        request.resource.data.disagreement == resource.data.disagreement &&
        request.resource.data.get('likeCount', 0) ==
          resource.data.get('likeCount', 0) &&
        translationFieldsUnchanged();
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;

      match /items/{itemId} {
        allow read: if canViewTopic(topicId);
        allow write: if ownsTopic(topicId) ||
          (signedIn() &&
           getAfter(/databases/$(database)/documents/topics/$(topicId)).data.creatorId == request.auth.uid);
      }

      match /submissions/{userId} {
        allow read: if canViewTopic(topicId);
        allow write: if signedIn() && request.auth.uid == userId &&
          canViewTopic(topicId);
      }

      match /talks/{talkId} {
        function canParticipate() {
          return signedIn() && canViewTopic(topicId) && emailVerifiedOrExempt() &&
            talkWritesEnabled();
        }

        function talkWritesEnabled() {
          let policy = get(/databases/$(database)/documents/clientPolicies/talks).data;
          return exists(/databases/$(database)/documents/clientPolicies/talks) &&
            policy.get('writesEnabled', false) == true &&
            policy.get('readProtocolVersion', 0) == 2 &&
            policy.get('minProtocolVersion', 0) == 2 &&
            policy.get('minClientBuild', 0) is int &&
            policy.get('minClientBuild', 0) >= 2;
        }

        function compatibleTalkClient() {
          let policy = get(/databases/$(database)/documents/clientPolicies/talks).data;
          return request.resource.data.get('clientProtocolVersion', 0) == 2 &&
            request.resource.data.get('clientBuild', 0) is int &&
            request.resource.data.get('clientBuild', 0) >= policy.minClientBuild;
        }

        function ownContent() {
          // Missing legacy ownership is never inferred from a name/topic owner.
          return resource.data.get('authorUserId', '') == request.auth.uid;
        }

        function emptyActivity(data) {
          return data.get('replies', []) == [] &&
            data.get('upvotes', 0) is int && data.get('downvotes', 0) is int &&
            data.get('upvotes', 0) == 0 && data.get('downvotes', 0) == 0;
        }

        function serializedDate(value) {
          return value is string && value.matches(
            '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3,6}Z?$'
          );
        }

        allow read: if canViewTopic(topicId);
        allow create: if canParticipate() && compatibleTalkClient() &&
          request.resource.data.keys().hasOnly([
            'id', 'author', 'body', 'rank', 'minutesAgo', 'createdAt',
            'authorUserId', 'attachedTier', 'replies', 'upvotes', 'downvotes',
            'clientProtocolVersion', 'clientBuild'
          ]) &&
          request.resource.data.get('id', '') == talkId &&
          request.resource.data.get('authorUserId', '') == request.auth.uid &&
          request.resource.data.get('author', null) is string &&
          request.resource.data.get('body', null) is string &&
          request.resource.data.get('rank', '') in ['ss', 's', 'a', 'b', 'c', 'd'] &&
          request.resource.data.get('minutesAgo', 0) is int &&
          request.resource.data.get('attachedTier', false) is bool &&
          (request.resource.data.get('createdAt', null) == null ||
           serializedDate(request.resource.data.createdAt)) &&
          emptyActivity(request.resource.data);
        // Freeze identity, embedded legacy replies and historical counters.
        allow update: if canParticipate() && compatibleTalkClient() && ownContent() &&
          request.resource.data.body is string &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['body', 'clientProtocolVersion', 'clientBuild']);
        // Only trusted recursive cleanup may remove a thread with children.
        allow delete: if false;

        match /replies/{replyId} {
          allow read: if canViewTopic(topicId) &&
            exists(/databases/$(database)/documents/topics/$(topicId)/talks/$(talkId));
          allow create: if canParticipate() && compatibleTalkClient() &&
            exists(/databases/$(database)/documents/topics/$(topicId)/talks/$(talkId)) &&
            request.resource.data.keys().hasOnly([
              'id', 'author', 'body', 'createdAt', 'stance', 'authorUserId',
              'parentReplyId', 'replies', 'upvotes', 'downvotes',
              'clientProtocolVersion', 'clientBuild'
            ]) &&
            replyId != 'root' && request.resource.data.get('id', '') == replyId &&
            request.resource.data.get('authorUserId', '') == request.auth.uid &&
            request.resource.data.get('author', null) is string &&
            request.resource.data.get('body', null) is string &&
            serializedDate(request.resource.data.get('createdAt', null)) &&
            request.resource.data.get('stance', null) in [null, 'agree', 'object'] &&
            (request.resource.data.get('parentReplyId', null) == null ||
             request.resource.data.parentReplyId is string) &&
            emptyActivity(request.resource.data);
          allow update: if canParticipate() && compatibleTalkClient() && ownContent() &&
            exists(/databases/$(database)/documents/topics/$(topicId)/talks/$(talkId)) &&
            request.resource.data.body is string &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['body', 'clientProtocolVersion', 'clientBuild']);
          allow delete: if false;
        }

        // One document per UID; votes maps root/reply IDs to up/down. A user
        // can replace only their own choices, never another user's choices or
        // the parent content/counters. Unknown targets have no display effect.
        match /reactions/{userId} {
          allow read: if canViewTopic(topicId) &&
            exists(/databases/$(database)/documents/topics/$(topicId)/talks/$(talkId));
          allow create, update: if canParticipate() && compatibleTalkClient() && request.auth.uid == userId &&
            exists(/databases/$(database)/documents/topics/$(topicId)/talks/$(talkId)) &&
            request.resource.data.keys().hasOnly(['userId', 'votes', 'clientProtocolVersion', 'clientBuild']) &&
            request.resource.data.get('userId', '') == userId &&
            request.resource.data.get('votes', null) is map &&
            request.resource.data.votes.size() <= 1000 &&
            request.resource.data.votes.values().toSet().hasOnly(['up', 'down']);
          allow delete: if canParticipate() && request.auth.uid == userId;
        }
      }

      match /reports/{reportId} {
        allow create: if signedIn() &&
          canViewTopic(topicId) &&
          emailVerifiedOrExempt() &&
          request.resource.data.reporterUserId == request.auth.uid;
        allow read, update, delete: if false;
      }

      match /likes/{userId} {
        allow read: if signedIn() && request.auth.uid == userId &&
          canViewTopic(topicId);
        allow create: if signedIn() && request.auth.uid == userId &&
          canViewTopic(topicId) &&
          emailVerifiedOrExempt() &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
    }
  }
}
