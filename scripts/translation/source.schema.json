{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tier Online translation source batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "createdAt", "targetLanguages", "items"],
  "properties": {
    "schemaVersion": {"const": 1},
    "batchId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "targetLanguages": {"type": "array", "items": {"enum": ["ja", "en", "ko", "zh-TW", "pt-BR"]}, "uniqueItems": true},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "contentVersion", "sourceLanguage", "targetLanguages", "codexTargetLanguages", "context", "content", "translationContext"],
        "properties": {
          "documentId": {"type": "string", "minLength": 1},
          "contentVersion": {"type": "integer", "minimum": 1},
          "sourceLanguage": {"enum": ["ja", "en", "ko", "zh-TW", "pt-BR"]},
          "targetLanguages": {"type": "array", "items": {"enum": ["ja", "en", "ko", "zh-TW", "pt-BR"]}, "uniqueItems": true},
          "codexTargetLanguages": {"type": "array", "items": {"enum": ["ja", "en", "ko", "zh-TW", "pt-BR"]}, "uniqueItems": true},
          "context": {"type": "object"},
          "translationContext": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dictionaryVersion", "commonTerms", "officialNames", "doNotTranslate"],
            "properties": {
              "dictionaryVersion": {"type": "string"},
              "commonTerms": {"type": "object"},
              "officialNames": {"type": "object"},
              "doNotTranslate": {"type": "array", "items": {"type": "string"}}
            }
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": {"type": "string"},
              "description": {"type": "string"},
              "category": {"type": "string"},
              "tags": {"type": "array", "items": {"type": "string"}},
              "itemNames": {"type": "object", "additionalProperties": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
